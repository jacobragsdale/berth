{
  "$defs": {
    "Autoscale": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "minimum": 1,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "minimum": 1,
          "title": "Max",
          "type": "integer"
        },
        "cpu_percent": {
          "default": 70,
          "maximum": 95,
          "minimum": 10,
          "title": "Cpu Percent",
          "type": "integer"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "Autoscale",
      "type": "object"
    },
    "Override": {
      "additionalProperties": false,
      "description": "An RFC 7386 JSON merge patch applied to one rendered object: the escape hatch for what the spec cannot say.",
      "properties": {
        "target": {
          "$ref": "#/$defs/OverrideTarget"
        },
        "patch": {
          "additionalProperties": true,
          "minProperties": 1,
          "title": "Patch",
          "type": "object"
        },
        "reason": {
          "minLength": 10,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "target",
        "patch",
        "reason"
      ],
      "title": "Override",
      "type": "object"
    },
    "OverrideTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "pattern": "^[A-Z][A-Za-z]+$",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "OverrideTarget",
      "type": "object"
    },
    "ServiceOverlay": {
      "additionalProperties": false,
      "properties": {
        "size": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]{1,8}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "replicas": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replicas"
        },
        "autoscale": {
          "anyOf": [
            {
              "$ref": "#/$defs/Autoscale"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ServiceOverlay",
      "type": "object"
    },
    "TaskOverlay": {
      "additionalProperties": false,
      "properties": {
        "size": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]{1,8}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        }
      },
      "title": "TaskOverlay",
      "type": "object"
    },
    "WorkflowOverlay": {
      "additionalProperties": false,
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "tasks": {
          "patternProperties": {
            "^[a-z](?:[a-z0-9-]{0,18}[a-z0-9])?$": {
              "$ref": "#/$defs/TaskOverlay"
            }
          },
          "title": "Tasks",
          "type": "object"
        }
      },
      "title": "WorkflowOverlay",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}@sha256:[0-9a-f]{64}$",
      "title": "Version",
      "type": "string"
    },
    "config": {
      "patternProperties": {
        "^[A-Z_][A-Z0-9_]*$": {
          "type": "string"
        }
      },
      "title": "Config",
      "type": "object"
    },
    "services": {
      "patternProperties": {
        "^[a-z](?:[a-z0-9-]{0,18}[a-z0-9])?$": {
          "$ref": "#/$defs/ServiceOverlay"
        }
      },
      "title": "Services",
      "type": "object"
    },
    "workflows": {
      "patternProperties": {
        "^[a-z](?:[a-z0-9-]{0,18}[a-z0-9])?$": {
          "$ref": "#/$defs/WorkflowOverlay"
        }
      },
      "title": "Workflows",
      "type": "object"
    },
    "overrides": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Override"
      },
      "title": "Overrides",
      "type": "array"
    }
  },
  "required": [
    "version"
  ],
  "title": "EnvFile",
  "type": "object"
}
