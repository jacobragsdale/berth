{
  "$defs": {
    "SoftwareInstall": {
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$",
          "title": "Cluster",
          "type": "string"
        },
        "namespace": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Namespace",
          "type": "string"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "secrets": {
          "patternProperties": {
            "^[a-z](?:[a-z0-9-]{0,38}[a-z0-9])?$": {
              "$ref": "#/$defs/SoftwareSecret"
            }
          },
          "title": "Secrets",
          "type": "object"
        }
      },
      "required": [
        "cluster",
        "namespace"
      ],
      "title": "SoftwareInstall",
      "type": "object"
    },
    "SoftwareSecret": {
      "additionalProperties": false,
      "description": "A Kubernetes Secret platform software reads, filled from the cluster's platform Key Vault by External Secrets.",
      "properties": {
        "type": {
          "default": "Opaque",
          "enum": [
            "Opaque",
            "kubernetes.io/tls"
          ],
          "title": "Type",
          "type": "string"
        },
        "data": {
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z0-9._-]+$": {
              "pattern": "^[A-Za-z0-9-]{1,127}$",
              "type": "string"
            }
          },
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "data"
      ],
      "title": "SoftwareSecret",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Cluster software (controllers, CRDs, webhooks) as a pinned Helm chart: `platform/software/<name>.yaml`.\n\nAnything that only runs a container, such as Redis, is an ordinary app instead. Charts are rendered with\n`helm template` at deploy time and applied by berth like everything else; Helm itself never installs anything.",
  "properties": {
    "description": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "repo": {
      "pattern": "^(https|oci)://\\S+$",
      "title": "Repo",
      "type": "string"
    },
    "chart": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Chart",
      "type": "string"
    },
    "version": {
      "pattern": "^v?\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "order": {
      "default": 0,
      "maximum": 99,
      "minimum": 0,
      "title": "Order",
      "type": "integer"
    },
    "values": {
      "additionalProperties": true,
      "title": "Values",
      "type": "object"
    },
    "installs": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$": {
          "$ref": "#/$defs/SoftwareInstall"
        }
      },
      "title": "Installs",
      "type": "object"
    }
  },
  "required": [
    "description",
    "repo",
    "chart",
    "version",
    "installs"
  ],
  "title": "Software",
  "type": "object"
}
